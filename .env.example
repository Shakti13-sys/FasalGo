# ==============================================================================
# FasalGo — Smart Procurement & Queue Intelligence Platform (SIH26032)
# Master Unified Configuration Template (.env.example)
# ==============================================================================

# Backend Core
APP_NAME="FasalGo - Smart Procurement & Queue Intelligence Engine"
APP_ENV="development"
DEBUG=true

# Database (Default: Local SQLite | Replace with PostgreSQL/Supabase for Cloud)
DATABASE_URL="sqlite:///./fasalgo.db"

# Security & JWT
SECRET_KEY="fasalgo-sih26032-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]

# Recommendation Scoring Weights
WEIGHT_DISTANCE=0.25
WEIGHT_WAIT_TIME=0.40
WEIGHT_CONGESTION=0.20
WEIGHT_AVAILABILITY=0.15

# Dynamic Rerouting Thresholds
REROUTE_MIN_ABSOLUTE_IMPROVEMENT_MINUTES=15.0
REROUTE_MIN_RELATIVE_IMPROVEMENT_PCT=20.0

# External APIs
GROQ_API_KEY=your_groq_api_key_here
MAPS_API_KEY=your_google_maps_key_here
SMS_GATEWAY_API_KEY=your_fast2sms_key_here
SMS_GATEWAY_PROVIDER=FAST2SMS
WEATHER_API_KEY=your_weather_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
