# ==============================================================================
# FasalGo Backend Configuration (.env)
# ==============================================================================

# Application Name & Environment
APP_NAME="FasalGo - Smart Procurement & Queue Intelligence Engine"
APP_ENV="development"
DEBUG=true

# Database Connection
# Default: Local SQLite database (works out of the box with zero setup)
# For Production / Supabase / PostgreSQL, set:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/fasalgo"
DATABASE_URL="sqlite:///./fasalgo.db"

# JWT Security
# Generate a secure secret in production, e.g. with `openssl rand -hex 32`
SECRET_KEY="fasalgo-sih26032-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed Frontend CORS Origins (comma-separated or list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]

# Intelligence & Recommendation Weights (Total = 1.0)
WEIGHT_DISTANCE=0.25
WEIGHT_WAIT_TIME=0.40
WEIGHT_CONGESTION=0.20
WEIGHT_AVAILABILITY=0.15

# Congestion Index Thresholds (0.0 to 1.0)
CONGESTION_LOW_MAX=0.35
CONGESTION_MEDIUM_MAX=0.70

# Reroute Trigger Thresholds
REROUTE_MIN_ABSOLUTE_IMPROVEMENT_MINUTES=15.0
REROUTE_MIN_RELATIVE_IMPROVEMENT_PCT=20.0

# Optional Third-Party Integrations
# SMS_GATEWAY_API_KEY=""
# WEATHER_API_KEY=""
# EXTERNAL_ML_MODEL_ENDPOINT=""
